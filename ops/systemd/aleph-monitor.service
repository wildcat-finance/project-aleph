[Unit]
Description=Project Aleph dependency monitor
After=network-online.target

[Service]
Type=oneshot
User=aleph-query
Group=aleph-query
WorkingDirectory=/opt/aleph
EnvironmentFile=/etc/aleph/gateway.env
EnvironmentFile=/etc/aleph/telegram.env
EnvironmentFile=-/etc/aleph/model.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/aleph/.venv/bin/python /opt/aleph/monitor.py --manifest /opt/aleph/manifest.yaml --artifacts /srv/aleph/artifacts --pointer /srv/aleph/active-release.json --prerelease /srv/aleph/artifacts/releases/REPLACE_V25_RELEASE_ID/release.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
