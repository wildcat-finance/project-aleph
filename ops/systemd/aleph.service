[Unit]
Description=Project Aleph Telegram query service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aleph-query
Group=aleph-query
WorkingDirectory=/opt/aleph
EnvironmentFile=/etc/aleph/gateway.env
EnvironmentFile=/etc/aleph/telegram.env
EnvironmentFile=/etc/aleph/audit.env
EnvironmentFile=-/etc/aleph/model.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aleph/.venv/bin/python /opt/aleph/serve.py --manifest /opt/aleph/manifest.yaml --artifacts /srv/aleph/artifacts --pointer /srv/aleph/active-release.json --prerelease /srv/aleph/artifacts/releases/REPLACE_V25_RELEASE_ID/release.json --audit-dir /var/log/aleph/audit --telegram-offset /var/lib/aleph-query/telegram-offset.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
DevicePolicy=closed
MemoryDenyWriteExecute=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/aleph-query /var/log/aleph
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
UMask=0077

[Install]
WantedBy=multi-user.target
