.venv/
__pycache__/
*.pyc

# Credentials. Nothing in this repository is secret and nothing here should
# ever become secret — service credentials live in the environment as
# ALEPH_GATEWAY_TOKEN and ALEPH_TELEGRAM_TOKEN, and a .env is how they usually
# reach a shell. If one is ever committed anyway, rotate it rather than reason
# about who might have seen it.
.env
.env.*
!.env.example
*.env
.envrc
ingest/keys/*.gpg
ingest/keys/*secret*

# Build artefacts: chunk output, corpus indexes and the driver's working
# clones are all reproducible from manifest.yaml and never belong in git.
# .aleph-work holds full checkouts of every source, which is a lot of someone
# else's repository to add by accident.
*.jsonl
chunks/
corpus/
index/
artifacts/
.aleph-work/
state/
var/
